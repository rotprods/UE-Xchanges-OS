# ═══════════════════════════════════════════════════════════════════════════════
# Chronos Quantum — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Supabase (Required for persistence) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Cron Security ────────────────────────────────────────────────────────────
CRON_SECRET=your-cron-secret-here

# ─── Database (Legacy Neon — optional, Supabase preferred) ────────────────────
# DATABASE_URL=postgres://user:pass@host/dbname

# ─── Binance API (for real trading — optional) ───────────────────────────────
# BINANCE_API_KEY=your-api-key
# BINANCE_API_SECRET=your-api-secret

# ─── Ethereum RPC (for on-chain whale tracking — optional) ───────────────────
# ETH_RPC_WSS=wss://mainnet.infura.io/ws/v3/your-key
