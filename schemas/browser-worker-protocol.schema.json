{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UEX Browser Worker Protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "body"],
  "properties": {
    "operation": {
      "enum": ["inspect", "prefill-local", "validate-local"]
    },
    "body": {
      "oneOf": [
        { "$ref": "#/$defs/inspectRequest" },
        { "$ref": "#/$defs/planRequest" }
      ]
    }
  },
  "$defs": {
    "inspectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "url", "allowed_origins"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "allowed_origins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https?://" }
        }
      }
    },
    "planRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan"],
      "properties": {
        "plan": { "type": "object" }
      }
    }
  }
}
