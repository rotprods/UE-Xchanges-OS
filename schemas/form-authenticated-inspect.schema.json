{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"AuthenticatedInspectClaims","type":"object","additionalProperties":false,"required":["evidence_id","runtime_attestation_id","provider_id","canonical_form_url","form_fingerprint","validation_signature","authenticated","human_login_ref","inspected_at","expires_at","form_values_read","cookies_read","storage_state_exported","nonce"],"properties":{"evidence_id":{"type":"string","minLength":1},"runtime_attestation_id":{"type":"string","minLength":1},"provider_id":{"type":"string","minLength":1},"canonical_form_url":{"type":"string","format":"uri"},"form_fingerprint":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"validation_signature":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"authenticated":{"type":"boolean"},"human_login_ref":{"type":["string","null"]},"inspected_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"form_values_read":{"const":false},"cookies_read":{"const":false},"storage_state_exported":{"const":false},"nonce":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"authenticated":{"const":true}}},"then":{"properties":{"human_login_ref":{"type":"string","minLength":1}}},"else":{"properties":{"human_login_ref":{"type":"null"}}}}]}
