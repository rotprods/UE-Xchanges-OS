{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UEX Control Plane Health Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_type", "generated_at", "overall", "metrics", "slos", "findings"],
  "properties": {
    "report_type": {"const": "control_plane_health_v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "overall": {"enum": ["GREEN", "AMBER", "RED"]},
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "slos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "observed", "target"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "observed": {"type": "number"},
          "target": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "subject_type", "subject_id", "detail", "repair_action"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "severity": {"enum": ["INFO", "WARNING", "ERROR", "CRITICAL"]},
          "subject_type": {"type": "string", "minLength": 1},
          "subject_id": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "repair_action": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
