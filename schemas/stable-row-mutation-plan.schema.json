{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UEX Stable Row Mutation Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "version", "mutation_key", "table", "stable_id_header", "stable_id",
    "first_row_number", "target_row_number", "row_moved_between_reads",
    "column_layout_changed_between_reads", "before_row_fingerprint", "after_row_fingerprint",
    "header_set_fingerprint", "mutations", "first_observed_at", "second_observed_at",
    "provider_write_executed"
  ],
  "properties": {
    "contract": {"const": "UEX_STABLE_ROW_MUTATION"},
    "version": {"const": "1.0.0"},
    "mutation_key": {"type": "string", "pattern": "^SRM-[0-9a-f]{64}$"},
    "table": {"type": "string", "minLength": 1},
    "stable_id_header": {"type": "string", "minLength": 1},
    "stable_id": {"type": "string", "minLength": 1},
    "first_row_number": {"type": "integer", "minimum": 1},
    "target_row_number": {"type": "integer", "minimum": 1},
    "row_moved_between_reads": {"type": "boolean"},
    "column_layout_changed_between_reads": {"type": "boolean"},
    "before_row_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "after_row_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "header_set_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["header", "row_number", "column_index_1based", "a1", "old_value", "new_value"],
        "properties": {
          "header": {"type": "string", "minLength": 1},
          "row_number": {"type": "integer", "minimum": 1},
          "column_index_1based": {"type": "integer", "minimum": 1},
          "a1": {"type": "string", "pattern": "^[A-Z]+[1-9][0-9]*$"},
          "old_value": {},
          "new_value": {}
        }
      }
    },
    "first_observed_at": {"type": "string", "format": "date-time"},
    "second_observed_at": {"type": "string", "format": "date-time"},
    "provider_write_executed": {"const": false}
  }
}
