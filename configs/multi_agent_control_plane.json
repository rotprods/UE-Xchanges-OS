    "minimum_scope": true,
    "block_unexpired_other_owner": true,
    "takeover_requires_event": true
  },
  "event_bus": {
    "append_only": true,
    "idempotency_components": [
      "project_id",
      "entity_type",
      "entity_id",
      "operation",
      "authoritative_source_version"
    ],
    "mutation_requires_active_lease": true,
    "read_only_events_require_lease": false
  },
  "consistency": {
    "mode": "READ_BEFORE_WRITE_PLUS_EVENTED_PROJECTIONS",
    "push_subscription_available": false,
    "projection_divergence_is_blocking": true
  },
  "privacy": {
    "public_repo_private_values": false,
    "private_profile_in_drive_only": true
  }
