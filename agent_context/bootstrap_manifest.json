{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "UEX_AGENT_BOOTSTRAP",
  "version": "1.1.0",
  "context_id": "CTX-UEX-GLOBAL-EXPANSION-INCOME-V1",
  "authority": "DERIVED_BOOTSTRAP_ROUTER_ONLY",
  "rules": {
    "chat_memory_is_authoritative": false,
    "memory_md_is_live_state": false,
    "agent_context_is_canonical_domain_truth": false,
    "must_refresh_before_every_write": true,
    "must_emit_bootstrap_ack_before_lease": true,
    "required_ack_event": "BOOTSTRAP_CONTEXT_LOADED",
    "must_evaluate_writer_authorization_before_lease": true,
    "must_emit_writer_authorization_receipt_before_lease": true,
    "required_writer_authorization_event": "WRITER_AUTHORIZATION_GRANTED",
    "writer_authorization_receipt_version": "1.0.0",
    "external_side_effects_require_separate_capability": true,
    "never_reuse_session_id_for_writes": true
  },
  "required_public_reads": [
    "CURRENT_GITHUB_MAIN_SHA",
    "goal.md",
    "AGENTS.md",
    "MEMORY.md",
    "LIVE-STATE-OVERRIDE.json",
    "STATE.md",
    "HANDOFF.md",
    "agent_context/README.md",
    "agent_context/context.md",
    "agent_context/progress.md",
    "agent_context/checkpoints.md",
    "agent_context/session.md",
    "agent_context/runtimegraph.md",
    "agent_context/knowledge.md",
    "agent_context/recovery.md",
    "docs/WRITER_AUTHORIZATION_AND_RELIABILITY_WATCHDOG.md",
    "docs/WRITER_AUTHORIZATION_RECEIPT.md"
  ],
  "required_private_reads": [
    "Drive:Context_Registry",
    "Drive:Agent_Sessions",
    "Drive:Work_Leases:UNEXPIRED_ONLY",
    "Drive:Agent_Event_Bus:AFTER_CONTEXT_CURSOR",
    "Drive:RuntimeGraphV2CommandCenter:Command_Center",
    "Drive:RuntimeGraphV2CommandCenter:Human_Now",
    "Drive:RuntimeGraphV2CommandCenter:Agent_Next",
    "Drive:RuntimeGraphV2CommandCenter:Source_Cursors",
    "Drive:RuntimeGraphV2CommandCenter:Dead_Letters"
  ],
  "freshness_checks": [
    "re-read current GitHub main before mutation",
    "re-read unexpired Work_Leases immediately before mutation",
    "read Event Bus tail after the stored context/event watermark",
    "generate or refresh ControlPlaneHealthReport before writer authorization",
    "inventory explicit overlapping unexpired lease IDs for the proposed scope",
    "reconcile target projection before write",
    "read fresh Gmail/official evidence when the action depends on external state"
  ],
  "bootstrap_ack_required_fields": [
    "manifest_version",
    "observed_main_sha",
    "context_id",
    "public_read_set_hash_or_refs",
    "private_event_watermark",
    "lease_scan_at",
    "agent_id",
    "session_id"
  ],
  "writer_authorization_receipt_required_fields": [
    "receipt_id",
    "issued_at",
    "expires_at",
    "session_id",
    "agent_id",
    "context_id",
    "manifest_version",
    "observed_main_sha",
    "intent",
    "proposed_lease_id",
    "scope_sha256",
    "authorization_decision_digest",
    "health_report_sha256",
    "prelease_event_watermark",
    "prelease_lease_scan_at",
    "coordination_allowed",
    "domain_authority",
    "external_capability"
  ],
  "write_sequence": [
    "READ_BOOTSTRAP_MANIFEST",
    "READ_REQUIRED_PUBLIC_CONTEXT",
    "READ_REQUIRED_PRIVATE_CONTEXT",
    "REGISTER_UNIQUE_SESSION",
    "EMIT_SESSION_STARTED",
    "EMIT_BOOTSTRAP_CONTEXT_LOADED",
    "REFRESH_UNEXPIRED_LEASES_AND_EVENT_TAIL",
    "EVALUATE_CONTROL_PLANE_HEALTH",
    "EVALUATE_WRITER_AUTHORIZATION",
    "EMIT_WRITER_AUTHORIZATION_GRANTED",
    "ACQUIRE_SMALLEST_SAFE_LEASE",
    "EXECUTE_BOUNDED_TRANSITION",
    "VERIFY_READ_BACK",
    "EMIT_EVENT",
    "RECOMPUTE_DERIVED_PROJECTIONS_IF_NEEDED",
    "RELEASE_LEASE",
    "SESSION_COMPLETED"
  ],
  "lease_acquired_required_authorization_refs": [
    "authorization_receipt_id",
    "authorization_decision_digest",
    "writer_authorization_receipt_version"
  ],
  "migration": {
    "receipt_enforcement": "NON_RETROACTIVE",
    "pre_1_1_leases": "do not classify as receipt violations solely because the v1.1 receipt contract did not yet exist",
    "existing_sessions": "refresh manifest before next lease acquisition; no existing lease is retroactively invalidated",
    "external_side_effects": "remain outside generic writer authorization and require a separately versioned capability contract"
  },
  "forbidden_bootstrap_shortcuts": [
    "write_from_chat_memory_only",
    "reuse_old_session_id",
    "treat_agent_context_as_live_authority",
    "treat_MEMORY.md_as_current_state",
    "trust_stale_ACTIVE_lease_without_expiry_event_reconciliation",
    "acquire_post_v1_1_write_lease_without_positive_writer_authorization",
    "acquire_post_v1_1_write_lease_without_WRITER_AUTHORIZATION_GRANTED_receipt",
    "treat_writer_authorization_receipt_as_domain_authority",
    "treat_writer_authorization_receipt_as_external_capability",
    "infer_submission_from_draft_task_open_form_or_route_query",
    "claim_merge_or_ci_without_github_evidence"
  ]
}
