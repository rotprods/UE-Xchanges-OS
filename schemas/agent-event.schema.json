{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rotprods/UE-Xchanges-OS/schemas/agent-event.schema.json",
  "title": "UE-Xchanges-OS Agent Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "occurred_at",
    "project_id",
    "context_id",
    "session_id",
    "agent_id",
    "event_type",
    "entity_type",
    "entity_id",
    "operation",
    "payload",
    "idempotency_key",
    "severity",
    "ack_required",
    "writer_version"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^(EVT-|evt_)[A-Za-z0-9_-]+$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "project_id": {"type": "string", "minLength": 1},
    "context_id": {"type": "string", "pattern": "^CTX-[A-Z0-9-]+$"},
    "session_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "pattern": "^AGT-[A-Z0-9-]+$"},
    "event_type": {"type": "string", "minLength": 1},
    "entity_type": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "state_before": {"type": ["string", "null"]},
    "state_after": {"type": ["string", "null"]},
    "payload": {"type": "object"},
    "source_ref": {"type": ["string", "null"]},
    "causal_parent_event_id": {"type": ["string", "null"]},
    "correlation_id": {"type": ["string", "null"]},
    "lease_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 16},
    "severity": {"enum": ["DEBUG", "INFO", "MATERIAL", "WARNING", "CRITICAL"]},
    "ack_required": {"type": "boolean"},
    "acked_by": {"type": ["string", "null"]},
    "processed_at": {"type": ["string", "null"], "format": "date-time"},
    "writer_version": {"type": "string", "minLength": 1},
    "notes": {"type": ["string", "null"]}
  }
}
