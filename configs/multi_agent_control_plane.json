  "tables": {
    "contexts": "Context_Registry",
    "sessions": "Agent_Sessions",
    "events": "Agent_Event_Bus",
    "leases": "Work_Leases",
    "inbox": "Agent_Inbox",
    "economics": "Opportunity_Economics",
    "sources": "Source_Coverage",
    "profile_questions": "Profile_Interview"
