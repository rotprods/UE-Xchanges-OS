{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UEX Recovery Drill Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "version", "drill_id", "started_at", "completed_at", "manifest_bundle_hash",
    "source_event_ids", "recovered_event_ids", "missing_event_ids", "unexpected_event_ids",
    "required_steps", "recovery_status", "rto_seconds", "event_loss_count",
    "measured_rpo_zero", "objective", "status"
  ],
  "properties": {
    "contract": {"const": "UEX_RECOVERY_DRILL"},
    "version": {"const": "1.0.0"},
    "drill_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "manifest_bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recovered_event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "missing_event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unexpected_event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_steps": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "recovery_status": {"enum": ["RECOVERABLE", "DEGRADED", "NOT_RECOVERABLE"]},
    "rto_seconds": {"type": "number", "minimum": 0},
    "event_loss_count": {"type": "integer", "minimum": 0},
    "measured_rpo_zero": {"type": "boolean"},
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_rto_seconds", "max_event_loss"],
      "properties": {
        "max_rto_seconds": {"type": "integer", "minimum": 1},
        "max_event_loss": {"type": "integer", "minimum": 0}
      }
    },
    "status": {"enum": ["PASS", "FAIL_RTO", "FAIL_RPO", "FAIL_RECOVERY", "FAIL_STEPS"]}
  }
}
