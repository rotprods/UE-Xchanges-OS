{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UEX Reconciliation Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id", "source_kind", "source_code", "subject_type", "subject_id",
    "operation", "surface", "risk", "required_lease_scope", "preconditions",
    "expected_readback", "evidence_requirements", "canonical_domain_mutation", "auto_execute"
  ],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^RPL-[0-9a-f]{16}$"},
    "source_kind": {"enum": ["health", "recovery"]},
    "source_code": {"type": "string", "minLength": 1},
    "subject_type": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "surface": {"type": "string", "minLength": 1},
    "risk": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "required_lease_scope": {"type": "string", "minLength": 1},
    "preconditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expected_readback": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_requirements": {"type": "array", "items": {"type": "string"}},
    "canonical_domain_mutation": {"const": false},
    "auto_execute": {"const": false}
  }
}
